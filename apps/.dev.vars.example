# Copy this file to .dev.vars for local development.
# .dev.vars is loaded by wrangler automatically and is gitignored.
# Generate ADMIN_PASSWORD_HASH and ADMIN_PASSWORD_SALT with: pnpm gen-hash

ADMIN_PASSWORD_HASH=replace_with_output_of_gen_hash
ADMIN_PASSWORD_SALT=replace_with_output_of_gen_hash
SESSION_SECRET=replace_with_random_32_char_string
RESEND_API_KEY=re_replace_with_resend_api_key
VOTE_TOKEN_SECRET=replace_with_random_32_char_string
